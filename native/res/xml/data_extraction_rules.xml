<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: keep the store that holds tokens (the Wise token) on this phone.
     It is left out of cloud backup and of phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
